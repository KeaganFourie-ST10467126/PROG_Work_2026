<Window x:Class="HotelManagerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagerWPF"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="MainWindow" Height="450" Width="800">

    <StackPanel Margin="15" Background="#FF35D27D">

        <TextBlock Text="Hotel Room Manager" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">

            <StackPanel Margin="5">
                <TextBlock Text="Room Number:" FontWeight="Bold"/>
                <TextBox x:Name="txt_RoomNumber" Width="120" Height="25" FontSize="14" Background="White"/>
            </StackPanel>

            <StackPanel Margin="5">
                <TextBlock Text="Room Type:" FontWeight="Bold"/>
                <TextBox x:Name="txt_RoomType" Width="160" Height="25" FontSize="14" Background="White"/>
            </StackPanel>

            <StackPanel Margin="5">
                <TextBlock Text="Status:" FontWeight="Bold"/>
                <TextBox x:Name="txt_Status" Width="160" Height="25" FontSize="14" Background="White"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,15">

            <Button x:Name="btn_Add" Content="Add" Width="100" Height="32" Margin="5" FontSize="14" FontWeight="Bold" Click="btn_Add_Click"/>

            <Button x:Name="btn_Update" Content="Update" Width="100" Height="32" Margin="5" FontSize="14" FontWeight="Bold" Click="btn_Update_Click"/>

            <Button x:Name="btn_Delete" Content="Delete" Width="100" Height="32" Margin="5" FontSize="14" FontWeight="Bold" Click="btn_Delete_Click"/>

            <Button x:Name="btn_Refresh" Content="Refresh" Width="100" Height="32" Margin="5" FontSize="14" FontWeight="Bold" Click="btn_Refresh_Click"/>

        </StackPanel>

        <TextBlock Text="Tip: click a row in the list to load it into the fields above" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ListView x:Name="lvRooms" Height="240" Width="570" FontSize="14" SelectionChanged="lvRooms_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Room Number" Width="140"
                                    DisplayMemberBinding="{Binding RoomNumber}"/>
                    <GridViewColumn Header="Room Type" Width="200"
                                    DisplayMemberBinding="{Binding RoomType}"/>
                    <GridViewColumn Header="Status" Width="200"
                                    DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>

    </StackPanel>

</Window>
