<Window x:Class="AppointmentDemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppointmentDemoApp"
        mc:Ignorable="d"
        Title="Appointment Manager" Height="510" Width="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

            <SolidColorBrush x:Key="PrimaryColour" Color="#FF5AAF1F"/>
            <SolidColorBrush x:Key="AccentColour" Color="#FFD63384"/>
            <SolidColorBrush x:Key="LightBackground" Color="#FFF8F0FB"/>
            <SolidColorBrush x:Key="WarningColour" Color="#FF911AE3"/>

        <Style TargetType="Button">

                <Setter Property="Background" Value="{StaticResource PrimaryColour }"></Setter>
                <Setter Property="Foreground" Value="White"></Setter>
                <Setter Property="FontWeight" Value="Bold"></Setter>
                <Setter Property="FontSize" Value="13"></Setter>

        </Style>

        <Style TargetType="TextBox">

            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColour }"></Setter>
            <Setter Property="BorderThickness" Value="4"></Setter>
            <Setter Property="Padding" Value="2"></Setter>
            <Setter Property="FontSize" Value="14"></Setter>
            <Setter Property="FontFamily" Value="Arial"></Setter>
        </Style>
    </Window.Resources>

        <StackPanel Margin="20" Background="#FFF2F6F6">

            <TextBlock Text="Appointment Manager"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,5"
                   Foreground="{StaticResource PrimaryColour }"/>

            <TextBlock Text="Type your appointment e.g. 'dentist tomorrow' or 'meeting in 3 days'"
                   FontStyle="Italic" Foreground="Gray"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBox x:Name="txt_Input"
                     Width="400" Height="32"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"
                     BorderBrush="{StaticResource PrimaryColour }"/>
            <Button Content="Add" Width="90" Height="32" BorderBrush="{StaticResource PrimaryColour}" Click="AddButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- The Border element provides the rounded corners -->
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
            <Button Content="Delete Selected" Width="140" Height="45" Click="Button_Click" Background="{StaticResource WarningColour }" BorderBrush="{StaticResource WarningColour }">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- The Border element provides the rounded corners -->
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

            <TextBlock Text="Tip: click a row to select it before deleting" FontStyle="Italic" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <ListView x:Name="lvAppointments" Height="260" FontSize="13">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" Width="50"
                                    DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Reason" Width="320"
                                    DisplayMemberBinding="{Binding Reason}"/>
                        <GridViewColumn Header="Reminder Date" Width="180"
                                    DisplayMemberBinding="{Binding ReminderDate}"/>
                    </GridView>
                </ListView.View>
            </ListView>

        </StackPanel>
    </Window>