<Window x:Class="JobApplicationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JobApplicationApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="906" Width="800">
    <StackPanel Background="#FF031E36" Margin="20">
        <TextBlock Text="Job Application Form" Foreground="White" FontWeight="Bold" FontSize="22" Width="221"></TextBlock>
        <Canvas Height="160" Background="#FF104450" Margin="10">
            <Label Content="Applicant Full Name:" Canvas.Left="26" Canvas.Top="10" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"></Label>
            <TextBox Name ="txtName" Canvas.Left="26" Canvas.Top="36" HorizontalAlignment="Left" VerticalAlignment="Center" Width="390"></TextBox>
            <Label Content="Position" Canvas.Top="54" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Canvas.Left="25" FontWeight="Bold"></Label>
            <TextBox Name ="txtPosition" Width="390" Canvas.Left="26" Canvas.Top="80"/>
            <Label Content="Expected Salary [R]" Foreground="White" Canvas.Top="98" Canvas.Left="25" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBox Name="txtExpSalary" Height="20" Width="390" RenderTransformOrigin="0.662,4.242" Canvas.Left="26" Canvas.Top="129"/>
        </Canvas>
        <Canvas Height="105" Background="#FF104450" Margin="10">
            <Label Content="Skills" Canvas.Left="30" Canvas.Top="10" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"></Label>
            <UniformGrid Rows="1" Canvas.Left="30" Canvas.Top="62" Height="17" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center">
                <CheckBox Content="C#" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                <CheckBox Content="Java" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                <CheckBox Content="Python" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
            </UniformGrid>
        </Canvas>
        <Canvas Height="100" Background="#FF104450" Margin="10">
            <Label Content="Availability" Canvas.Left="30" Canvas.Top="10" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"></Label>
            <ComboBox Name="PreferenceCanvas" Height="30" Width="400" Canvas.Left="30" Canvas.Top="47" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White">
                <ComboBoxItem Content="Full-time" Name="fullTime"/>
                <ComboBoxItem Content="Part-time" Name="partTime"/>
                <ComboBoxItem Content="Freelance" Name="freelance"/>
            </ComboBox>
        </Canvas>
        <Canvas Height="80" Background="#FF104450" Margin="10">
            <Label Content="Preferred Work Type" Canvas.Left="30" Canvas.Top="10" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" FontSize="20"></Label>
            <RadioButton Name="remote" Content="Remote" Canvas.Left="30" Canvas.Top="47" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" FontWeight="Bold"/>
            <RadioButton Name="onSite" Content="On-site" Canvas.Left="150" Canvas.Top="47" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" FontWeight="Bold"/>
        </Canvas>
        <Canvas Height="58" Margin="10">
            <Button Name="btnSubmit" Content="Submit Application" Canvas.Left="295" Canvas.Top="14" Width="150" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White" Foreground="Black" FontWeight="Bold"/>
        </Canvas>
        <Canvas Height="208">
            <TextBlock x:Name="txtOutput" Canvas.Left="188" Width="384" Height="198" TextWrapping="Wrap" Background="White"  Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Canvas>
    </StackPanel>
</Window>
